# Only needed if settings.yaml sets llm.provider: openai_compatible
# (Groq / Gemini / OpenRouter free tiers). Local Ollama is the default and needs nothing here.
JOBPILOT_LLM_API_KEY=
JOBPILOT_LLM_BASE_URL=https://api.groq.com/openai/v1

# Search discovery (settings.yaml `discovery:`) -- set the one for discovery.provider.
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SERPAPI_API_KEY=
